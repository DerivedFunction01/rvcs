generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── POS Configuration (Fetched on Init) ───────────────────────────────────────
// Defines available order types and their required customer fields.
// Similar to how a standard POS configures walk-in/pickup/delivery flows.

model PosConfig {
  id        String   @id @default(cuid())
  key       String   @unique          // e.g. "default", "store-42"
  label     String                    // e.g. "Main Location"
  config    String                    // JSON: { orderTypes: [...] }
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  floors    Floor[]
}

// ─── Product Catalog (The Menu) ────────────────────────────────────────────────

model CatalogItem {
  sku          String   @id
  name         String
  basePrice    Float
  category     String   @default("general")
  type         String   @default("item") // "item" | "modifier"
  dietaryFlags String   @default("[]")   // JSON array: ["gluten_free", "vegan"]
  allergens    String   @default("[]")   // JSON array: ["peanuts", "dairy"]
  brand        String   @default("")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // A size option is just a modifier CatalogItem that belongs to a size group
  sizeGroupId  String?
  sizeGroup    SizeGroup? @relation("SizeGroupOptions", fields: [sizeGroupId], references: [id])

  // Items can have a SizeGroup linked to them
  appliedSizeGroupId String?
  appliedSizeGroup    SizeGroup? @relation("ItemSizeGroup", fields: [appliedSizeGroupId], references: [id])

  // Relations
  allowedStates  ModifierStateOption[] @relation("ModifierStates")
  allowedModifiers ItemModifier[] @relation("ItemModifiers")
  modifierOf       ItemModifier[] @relation("ModifierItems")
}

model SizeGroup {
  id           String        @id @default(cuid())
  name         String        // e.g., "Size"
  defaultSku   String        // e.g., "MOD-SIZE-SML"
  options      CatalogItem[] @relation("SizeGroupOptions")
  items        CatalogItem[] @relation("ItemSizeGroup")
}

model ModifierStateOption {
  id              String      @id @default(cuid())
  modifierSku     String
  modifier        CatalogItem @relation("ModifierStates", fields: [modifierSku], references: [sku], onDelete: Cascade)
  state           String      // "NO" | "LESS" | "ADD" | "EXTRA" | "ONLY" | "WITH" | "SIDE"
  label           String      // e.g., "No Onions", "Extra Cheese"
  priceOverride   Float?
}

model ItemModifier {
  itemSku     String
  modifierSku String

  item        CatalogItem @relation("ItemModifiers", fields: [itemSku], references: [sku], onDelete: Cascade)
  modifier    CatalogItem @relation("ModifierItems", fields: [modifierSku], references: [sku], onDelete: Cascade)

  @@id([itemSku, modifierSku])
}


// ─── Transaction Repositories (One per order/cart) ─────────────────────────────

model Server {
  id        String            @id @default(cuid())
  name      String            @unique // e.g. "Tom", "Mia", "Server 12"
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  repos     TransactionRepo[]
}

model Floor {
  id          String           @id @default(cuid())
  posConfigId String?
  posConfig   PosConfig?       @relation(fields: [posConfigId], references: [id], onDelete: SetNull)
  name        String
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  objects     FloorObject[]

  @@index([posConfigId, sortOrder])
}

model FloorObject {
  id         String     @id @default(cuid())
  floorId    String
  floor      Floor      @relation(fields: [floorId], references: [id], onDelete: Cascade)
  type       String     // table | chair | wall | deadspace
  name       String
  shapeType  String?    // circle | ellipse | rectangle | triangle | polygon
  points     String     // JSON array of points
  x          Int
  y          Int
  w          Int
  h          Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  tableLinksAsTable TableChairLink[] @relation("table_object")
  tableLinksAsChair TableChairLink[] @relation("chair_object")

  @@index([floorId, type])
}

model TableChairLink {
  id         String      @id @default(cuid())
  tableId    String
  chairId    String
  table      FloorObject @relation("table_object", fields: [tableId], references: [id], onDelete: Cascade)
  chair      FloorObject @relation("chair_object", fields: [chairId], references: [id], onDelete: Cascade)

  @@unique([tableId, chairId])
  @@index([chairId])
}

model TransactionRepo {
  id          String   @id @default(cuid())
  serverId    String?
  server      Server?  @relation(fields: [serverId], references: [id], onDelete: SetNull)
  serverName  String?  @unique // Human-friendly server name for the checkout terminal
  contextType String   @default("cart") // "cart" | "catalog" | "inventory_warehouse"
  contextId   String                  // e.g. "table-12", "web-session-abc"
  status      String   @default("active") // "active" | "settled" | "void"
  createdAt   DateTime @default(now())
  settledAt   DateTime?
  commits     TransactionCommit[]

  @@index([serverName])
}

// ─── Transaction Commits (The Append-Only Ledger) ──────────────────────────────

model TransactionCommit {
  id                String   @id @default(cuid())
  repoId            String
  repo              TransactionRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  commitHash        String   @unique
  parentHash        String?
  mergeParentHashes String   @default("[]") // JSON array of strings
  branch            String   @default("main")
  timestamp         DateTime
  authorId          String
  deltas            String                  // JSON array of delta operations
  metadata          String   @default("{}") // JSON object
  createdAt         DateTime @default(now())

  @@index([repoId, branch])
  @@index([repoId, commitHash])
  @@index([parentHash])
}
