generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── POS Configuration (Fetched on Init) ───────────────────────────────────────
// Defines available order types and their required customer fields.
// Similar to how a standard POS configures walk-in/pickup/delivery flows.

model PosConfig {
  id        String   @id @default(cuid())
  key       String   @unique          // e.g. "default", "store-42"
  label     String                    // e.g. "Main Location"
  config    String                    // JSON: { orderTypes: [...] }
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  floors    Floor[]
}

// ─── Product Catalog (The Menu) ────────────────────────────────────────────────

model CatalogItem {
  sku          String   @id
  name         String
  basePrice    Float
  category     String   @default("general")
  type         String   @default("item") // "item" | "modifier"
  dietaryFlags String   @default("[]")   // JSON array: ["gluten_free", "vegan"]
  allergens    String   @default("[]")   // JSON array: ["peanuts", "dairy"]
  brand        String   @default("")
  active       Boolean  @default(true)
  comboChoices String   @default("[]")   // JSON array: [{"slotSku": "SKU-BASE-BURGER", "optionSku": "SKU-BURGER-REG", "price": 4.00}, ...]
  mainQtyIncrement                 Float?    @default(1.0)
  inlineQtyType                    String?
  inlineQtyLabel                   String?
  inlineQtyUnit                    String?
  inlineQtyIncrement               Float?    @default(1.0)
  inlineQtyPricePerUnit            Boolean   @default(false)
  inlineQtyPricePerUnitShowPer     Boolean   @default(true)
  inlineQtyMainQtyLocked           Boolean   @default(false)
  createdAt                        DateTime  @default(now())

  // A size option is just a modifier CatalogItem that belongs to a size group
  sizeGroupId  String?
  sizeGroup    SizeGroup? @relation("SizeGroupOptions", fields: [sizeGroupId], references: [id])

  // Items can have a SizeGroup linked to them
  appliedSizeGroupId String?
  appliedSizeGroup    SizeGroup? @relation("ItemSizeGroup", fields: [appliedSizeGroupId], references: [id])

  // Relations
  allowedStates    ModifierStateOption[] @relation("ModifierStates")
  allowedModifiers ItemModifier[]        @relation("ItemModifiers")
  modifierOf       ItemModifier[]        @relation("ModifierItems")
  chargeTags       SkuChargeTag[]
}

model IconConfig {
  id      String @id
  type    String
  label   String
  icon    String
  color   String
}


// ─── Charge / Tax System ────────────────────────────────────────────────────────
// Jurisdiction-aware, tag-based charge engine.
// Covers: sales tax, excise, import duties, operator surcharges.

model ChargeJurisdiction {
  id         String       @id @default(cuid())
  code       String       @unique
  // Geographic: "18106" | "US-PA-LEHIGH" | "US-PA" | "US"
  // Trade:      "US-TRADE" (federal trade policy — parallel to geographic "US")
  name       String
  type       String
  // "zip" | "county" | "state" | "federal" | "trade"
  parentCode String?      // walks up the geographic hierarchy
  createdAt  DateTime     @default(now())

  rules      ChargeRule[]
}

model ChargeTag {
  id           String         @id @default(cuid())
  code         String         @unique
  // "GENERAL" | "PREPARED_FOOD" | "GROCERY" | "ALCOHOL" | "EXEMPT" | etc.
  label        String
  description  String         @default("")
  categoryHint String         @default("sales_tax")
  // "sales_tax" | "excise" | "import_duty" | "surcharge"
  createdAt    DateTime       @default(now())

  rules        ChargeRule[]
  skus         SkuChargeTag[]
}

model ChargeRule {
  id               String             @id @default(cuid())
  jurisdictionId   String
  jurisdiction     ChargeJurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  tagId            String
  tag              ChargeTag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  chargeCategory   String
  // "sales_tax" | "excise" | "import_duty" | "surcharge"
  rateType         String
  // "percentage" | "per_unit" | "compound"
  calculationBasis String   @default("retail_price")
  // "retail_price" | "wholesale_cost" | "subtotal" | "subtotal_plus_tax"
  rate             Float
  originCode       String?
  // ISO-3166 alpha-2 filter: "CN", "CA" — null means applies regardless of origin
  priority         Int      @default(0)
  effectiveFrom    DateTime @default(now())
  effectiveTo      DateTime?
  createdAt        DateTime @default(now())

  @@index([jurisdictionId, tagId])
  @@index([originCode])
}

model SkuChargeTag {
  skuId      String
  tagId      String
  originCode String?     // origin of this SKU's goods (for tariff rule matching)
  sku        CatalogItem @relation(fields: [skuId], references: [sku], onDelete: Cascade)
  tag        ChargeTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([skuId, tagId])
  @@index([skuId])
}

model SizeGroup {
  id           String        @id @default(cuid())
  name         String        // e.g., "Size"
  defaultSku   String        // e.g., "MOD-SIZE-SML"
  options      CatalogItem[] @relation("SizeGroupOptions")
  items        CatalogItem[] @relation("ItemSizeGroup")
}

model ModifierStateOption {
  id              String      @id @default(cuid())
  modifierSku     String
  modifier        CatalogItem @relation("ModifierStates", fields: [modifierSku], references: [sku], onDelete: Cascade)
  state           String      // "NO" | "LESS" | "ADD" | "EXTRA" | "ONLY" | "WITH" | "SIDE"
  label           String      // e.g., "No Onions", "Extra Cheese"
  priceOverride   Float?
}

model ItemModifier {
  itemSku     String
  modifierSku String
  allowDuplicates Boolean @default(false)

  item        CatalogItem @relation("ItemModifiers", fields: [itemSku], references: [sku], onDelete: Cascade)
  modifier    CatalogItem @relation("ModifierItems", fields: [modifierSku], references: [sku], onDelete: Cascade)

  @@id([itemSku, modifierSku])
}


// ─── Transaction Repositories (One per order/cart) ─────────────────────────────

model Server {
  id        String            @id @default(cuid())
  name      String            @unique // e.g. "Tom", "Mia", "Server 12"
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  repos     TransactionRepo[]
}

model Floor {
  id          String           @id @default(cuid())
  posConfigId String?
  posConfig   PosConfig?       @relation(fields: [posConfigId], references: [id], onDelete: SetNull)
  name        String
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  objects     FloorObject[]

  @@index([posConfigId, sortOrder])
}

model FloorObject {
  id         String     @id @default(cuid())
  floorId    String
  floor      Floor      @relation(fields: [floorId], references: [id], onDelete: Cascade)
  type       String     // table | chair | wall | deadspace
  name       String
  displayName String?
  zIndex     Int?
  shapeType  String?    // circle | ellipse | rectangle | triangle | polygon
  x          Float
  y          Float
  rotation   Float      @default(0)
  width      Float?
  height     Float?
  radius     Float?
  radiusX    Float?
  radiusY    Float?
  points     String?    // JSON array of points
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  tableLinksAsTable TableChairLink[] @relation("table_object")
  tableLinksAsChair TableChairLink[] @relation("chair_object")

  @@index([floorId, type])
}

model TableChairLink {
  id         String      @id @default(cuid())
  tableId    String
  chairId    String
  table      FloorObject @relation("table_object", fields: [tableId], references: [id], onDelete: Cascade)
  chair      FloorObject @relation("chair_object", fields: [chairId], references: [id], onDelete: Cascade)

  @@unique([tableId, chairId])
  @@index([chairId])
}

model TransactionRepo {
  id          String   @id @default(cuid())
  serverId    String?
  server      Server?  @relation(fields: [serverId], references: [id], onDelete: SetNull)
  serverName  String?  @unique // Human-friendly server name for the checkout terminal
  contextType String   @default("cart") // "cart" | "catalog" | "inventory_warehouse"
  contextId   String                  // e.g. "table-12", "web-session-abc"
  status      String   @default("active") // "active" | "settled" | "void"
  createdAt   DateTime @default(now())
  settledAt   DateTime?
  commits     TransactionCommit[]

  @@index([serverName])
}

// ─── Transaction Commits (The Append-Only Ledger) ──────────────────────────────

model TransactionCommit {
  id                String   @id @default(cuid())
  repoId            String
  repo              TransactionRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  commitHash        String   @unique
  parentHash        String?
  mergeParentHashes String   @default("[]") // JSON array of strings
  branch            String   @default("main")
  timestamp         DateTime
  authorId          String
  deltas            String                  // JSON array of delta operations
  metadata          String   @default("{}") // JSON object
  createdAt         DateTime @default(now())

  @@index([repoId, branch])
  @@index([repoId, commitHash])
  @@index([parentHash])
}

// ─── Customer Profiles ─────────────────────────────────────────────────────────

model CustomerProfile {
  id               String              @id @default(cuid())
  loyaltyTier      String              @default("standard") // "standard" | "bronze" | "silver" | "gold"
  createdAt        DateTime            @default(now())
  names            CustomerName[]
  attributes       CustomerAttribute[]
  contacts         CustomerContact[]
  deliveryLocations DeliveryLocation[]
}

model CustomerName {
  id          String          @id @default(cuid())
  customerId  String
  customer    CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  middleName  String?
  suffix      String?
  displayName String

  @@index([customerId])
}

model CustomerAttribute {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  key        String
  value      String

  @@index([customerId])
}

model CustomerContact {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    String          // "email" | "phone" | "sms"
  value      String
  isPrimary  Boolean         @default(false)

  @@index([customerId])
}

model DeliveryLocation {
  id               String          @id @default(cuid())
  customerId       String
  customer         CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  formattedAddress String
  geoCoordinates   String?         // "lat,lng"
  isDefault        Boolean         @default(false)
  lastUsed         DateTime?

  @@index([customerId])
}
